<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recloud.mapper.CommentMapper">

    <!--
        管理端评论分页查询
        LEFT JOIN user 关联评论者昵称，LEFT JOIN annotation 关联所评批注的原文片段，
        直接产出含审核上下文的 AdminCommentVO，避免暴露原始实体并消除 N+1。
        分页 LIMIT 由 MyBatis-Plus 分页拦截器自动追加，此处无需手写。
        下划线列别名借助 map-underscore-to-camel-case 自动映射到 VO 驼峰字段。
    -->
    <select id="selectAdminCommentPage" resultType="com.recloud.vo.AdminCommentVO">
        SELECT
            c.id,
            c.annotation_id,
            c.user_id,
            c.reply_to_id,
            c.content,
            c.created_at,
            u.nickname      AS user_nickname,
            a.selected_text AS annotation_selected_text
        FROM annotation_comment c
        LEFT JOIN user u       ON c.user_id       = u.id
        LEFT JOIN annotation a ON c.annotation_id = a.id
        <where>
            <if test="keyword != null and keyword != ''">
                AND c.content LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY c.created_at DESC
    </select>

</mapper>
