<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recloud.mapper.ContentReportMapper">

    <!--
        管理端举报分页查询
        两次 LEFT JOIN user 分别关联举报人昵称与处理人昵称，直接产出 AdminReportVO，
        避免暴露原始实体并消除逐条查询用户昵称的 N+1 问题。
        分页 LIMIT 由 MyBatis-Plus 分页拦截器自动追加，此处无需手写。
        下划线列别名借助 map-underscore-to-camel-case 自动映射到 VO 驼峰字段。
    -->
    <select id="selectAdminReportPage" resultType="com.recloud.vo.AdminReportVO">
        SELECT
            r.id,
            r.reporter_id,
            r.target_type,
            r.target_id,
            r.reason,
            r.status,
            r.handler_id,
            r.handle_note,
            r.created_at,
            ru.nickname AS reporter_nickname,
            hu.nickname AS handler_nickname
        FROM content_report r
        LEFT JOIN user ru ON r.reporter_id = ru.id
        LEFT JOIN user hu ON r.handler_id = hu.id
        <where>
            <if test="status != null and status != ''">
                AND r.status = #{status}
            </if>
        </where>
        ORDER BY r.created_at DESC
    </select>

</mapper>
