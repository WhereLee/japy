# ============================================================
# 环境变量模板（复制为 .env 并填入真实值；.env 已被 gitignore，绝不入库）
# 用法：cp .env.example .env
# ============================================================

# ---- LLM（Java 后端 + rag 共用）----
# DeepSeek API 密钥（在 platform.deepseek.com 创建）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# API 地址与模型（rag 使用）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ---- JWT（可选，application.yml 有默认值，生产环境务必覆盖）----
# JWT_SECRET=replace-with-a-strong-secret-at-least-32-chars
